{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fairwatt/rates.schema.json",
  "title": "RatesFile (data/build/rates.json)",
  "type": "object",
  "required": ["source", "monthly", "fixedTerms", "current"],
  "additionalProperties": false,
  "$defs": {
    "utility": { "enum": ["NG", "EV_EAST", "EV_WEST", "UNITIL"] },
    "ym": { "type": "string", "pattern": "^(19|20)\\d\\d-(0[1-9]|1[0-2])$" },
    "cents": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
  },
  "properties": {
    "source": {
      "type": "object",
      "required": ["id", "file", "retrieved", "checksum"],
      "properties": {
        "id": { "const": "S1" },
        "file": { "type": "string", "minLength": 1 },
        "retrieved": { "type": "string", "format": "date" },
        "checksum": { "type": "string" }
      }
    },
    "monthly": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["ym", "utility", "cents"], "additionalProperties": false,
        "properties": { "ym": { "$ref": "#/$defs/ym" }, "utility": { "$ref": "#/$defs/utility" }, "cents": { "$ref": "#/$defs/cents" } }
      }
    },
    "fixedTerms": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["utility", "start", "end", "months", "cents"], "additionalProperties": false,
        "properties": {
          "utility": { "$ref": "#/$defs/utility" },
          "start": { "oneOf": [{ "$ref": "#/$defs/ym" }, { "type": "null" }] },
          "end": { "$ref": "#/$defs/ym" },
          "months": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 12 }, { "type": "null" }] },
          "cents": { "$ref": "#/$defs/cents" }
        }
      }
    },
    "current": {
      "type": "object",
      "required": ["NG", "EV_EAST", "EV_WEST", "UNITIL"],
      "additionalProperties": false,
      "patternProperties": {
        "^(NG|EV_EAST|EV_WEST|UNITIL)$": {
          "type": "object", "required": ["termStart", "termEnd", "cents"],
          "properties": {
            "termStart": { "oneOf": [{ "$ref": "#/$defs/ym" }, { "type": "null" }] },
            "termEnd": { "$ref": "#/$defs/ym" },
            "cents": { "$ref": "#/$defs/cents" }
          }
        }
      }
    }
  }
}
