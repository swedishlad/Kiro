{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "fairwatt/mc_forecast.schema.json",
 "title": "McForecastFile (data/build/mc_forecast.json)",
 "type": "object",
 "required": [
  "asOf",
  "horizon",
  "nPaths",
  "seed",
  "method",
  "levelAdjustment",
  "areas",
  "calibration",
  "notes"
 ],
 "properties": {
  "asOf": {
   "type": "string",
   "format": "date"
  },
  "horizon": {
   "type": "array",
   "minItems": 6,
   "maxItems": 6,
   "items": {
    "type": "string",
    "pattern": "^(19|20)\\d\\d-(0[1-9]|1[0-2])$"
   }
  },
  "nPaths": {
   "type": "integer",
   "minimum": 1000
  },
  "seed": {
   "type": "integer"
  },
  "method": {
   "type": "string",
   "minLength": 20
  },
  "levelAdjustment": {
   "type": "object",
   "required": [
    "source",
    "ratio"
   ],
   "properties": {
    "source": {
     "enum": [
      "S15 all-sector",
      "none: observed load"
     ]
    },
    "ratio": {
     "type": "number",
     "exclusiveMinimum": 0
    }
   }
  },
  "areas": {
   "type": "array",
   "minItems": 4,
   "maxItems": 4,
   "items": {
    "type": "object",
    "required": [
     "area",
     "unit",
     "months",
     "total",
     "samplePaths",
     "sameMonthsLastObservedGWh"
    ],
    "properties": {
     "area": {
      "enum": [
       "NEMA",
       "SEMA",
       "WCMA",
       "MA"
      ]
     },
     "unit": {
      "const": "GWh"
     },
     "months": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
       "allOf": [
        {
         "type": "object",
         "required": [
          "p5",
          "p10",
          "p25",
          "p50",
          "p75",
          "p90",
          "p95"
         ],
         "properties": {
          "p5": {
           "type": "number"
          },
          "p10": {
           "type": "number"
          },
          "p25": {
           "type": "number"
          },
          "p50": {
           "type": "number"
          },
          "p75": {
           "type": "number"
          },
          "p90": {
           "type": "number"
          },
          "p95": {
           "type": "number"
          }
         }
        },
        {
         "type": "object",
         "required": [
          "ym"
         ],
         "properties": {
          "ym": {
           "type": "string",
           "pattern": "^(19|20)\\d\\d-(0[1-9]|1[0-2])$"
          }
         }
        }
       ]
      }
     },
     "total": {
      "type": "object",
      "required": [
       "p5",
       "p10",
       "p25",
       "p50",
       "p75",
       "p90",
       "p95"
      ],
      "properties": {
       "p5": {
        "type": "number"
       },
       "p10": {
        "type": "number"
       },
       "p25": {
        "type": "number"
       },
       "p50": {
        "type": "number"
       },
       "p75": {
        "type": "number"
       },
       "p90": {
        "type": "number"
       },
       "p95": {
        "type": "number"
       }
      }
     },
     "samplePaths": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
       "type": "array",
       "minItems": 6,
       "maxItems": 6,
       "items": {
        "type": "number"
       }
      }
     },
     "sameMonthsLastObservedGWh": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
       "type": "number"
      }
     }
    }
   }
  },
  "calibration": {
   "type": "object",
   "required": [
    "trainEnd",
    "test",
    "nMonths",
    "cov80",
    "cov90",
    "maeVsNaive"
   ],
   "properties": {
    "trainEnd": {
     "type": "string",
     "format": "date"
    },
    "test": {
     "type": "string"
    },
    "nMonths": {
     "type": "integer",
     "minimum": 1
    },
    "cov80": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "cov90": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "maeVsNaive": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "backtest": {
   "type": "object",
   "required": [
    "winters",
    "nWinters",
    "nMonths",
    "cov80",
    "cov90",
    "maeVsNaive",
    "totalBiasPct",
    "totalMaePct",
    "totalCov80"
   ],
   "properties": {
    "winters": {
     "type": "string"
    },
    "nWinters": {
     "type": "integer",
     "minimum": 1
    },
    "nMonths": {
     "type": "integer",
     "minimum": 1
    },
    "cov80": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "cov90": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "maeVsNaive": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "totalBiasPct": {
     "type": "number"
    },
    "totalMaePct": {
     "type": "number",
     "minimum": 0
    },
    "totalCov80": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   }
  },
  "recentLevel": {
   "type": "object",
   "required": [
    "NEMA",
    "SEMA",
    "WCMA"
   ],
   "additionalProperties": {
    "type": "number"
   }
  },
  "levelSdPct": {
   "type": "object",
   "required": [
    "NEMA",
    "SEMA",
    "WCMA"
   ],
   "additionalProperties": {
    "type": "number"
   }
  }
 }
}
