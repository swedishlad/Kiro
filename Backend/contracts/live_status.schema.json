{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "live_status.schema.json",
 "title": "LiveStatus (data/build/live_status.json) v2.4.0",
 "description": "Written by backend/live/update.py only after every gate passed: how fresh the data behind the site is.",
 "type": "object",
 "required": [
  "builtAt",
  "gridThrough",
  "homesThrough",
  "forecastHorizon",
  "schedule",
  "sources",
  "gates"
 ],
 "properties": {
  "builtAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
  },
  "gridThrough": {
   "type": "string",
   "format": "date"
  },
  "homesThrough": {
   "type": "string",
   "pattern": "^(19|20)\\d\\d-(0[1-9]|1[0-2])$"
  },
  "forecastHorizon": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2,
   "items": {
    "type": "string",
    "pattern": "^(19|20)\\d\\d-(0[1-9]|1[0-2])$"
   }
  },
  "schedule": {
   "type": "string"
  },
  "sources": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "from",
     "to"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^S\\d+$"
     },
     "name": {
      "type": "string"
     },
     "from": {
      "type": "string"
     },
     "to": {
      "type": "string"
     }
    }
   }
  },
  "gates": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "contains": {
    "const": "G-LIVE"
   }
  }
 }
}
