{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fairwatt/towns.schema.json",
  "title": "TownsFile (data/build/towns.json)",
  "type": "object",
  "required": ["w", "h", "crs", "source", "simplifyIntervalMeters", "towns"],
  "properties": {
    "w": { "const": 680 },
    "h": { "const": 420 },
    "crs": { "type": "string" },
    "source": { "type": "string" },
    "simplifyIntervalMeters": { "type": "number", "minimum": 0 },
    "towns": {
      "type": "array", "minItems": 351, "maxItems": 351,
      "items": {
        "type": "object", "required": ["id", "name", "census", "geoid", "cx", "cy", "d"], "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 351 },
          "name": { "type": "string", "minLength": 1, "description": "massgis_name, upper case (BOSTON)" },
          "census": { "type": "string", "minLength": 1, "description": "census_name, mixed case (Boston) - use for search and display" },
          "geoid": { "type": "string", "pattern": "^25\\d{8}$" },
          "cx": { "type": "number", "minimum": 0, "maximum": 680 },
          "cy": { "type": "number", "minimum": 0, "maximum": 420 },
          "d": { "type": "string", "pattern": "^M", "not": { "pattern": "NaN|Infinity" } }
        }
      }
    }
  }
}
