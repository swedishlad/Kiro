{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "fairwatt/regimes.schema.json",
 "title": "RegimesFile (data/build/regimes.json) v2.3.0",
 "type": "object",
 "required": [
  "asOf",
  "method",
  "series",
  "definition",
  "areas",
  "leakageTest",
  "notes"
 ],
 "properties": {
  "asOf": {
   "type": "string",
   "format": "date"
  },
  "method": {
   "type": "string",
   "minLength": 20
  },
  "series": {
   "const": "consumption vs historical average range (same period, previous 5 years)"
  },
  "definition": {
   "type": "object",
   "required": [
    "red",
    "grey",
    "green",
    "range"
   ]
  },
  "leakageTest": {
   "const": "pass"
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "areas": {
   "type": "array",
   "minItems": 5,
   "maxItems": 5,
   "items": {
    "type": "object",
    "required": [
     "area",
     "unit",
     "states",
     "transition",
     "current",
     "timeline",
     "monthly",
     "outlook",
     "agreementWithBandRule"
    ],
    "properties": {
     "area": {
      "enum": [
       "NEMA",
       "SEMA",
       "WCMA",
       "MA",
       "MA_RES"
      ]
     },
     "unit": {
      "enum": [
       "day",
       "month"
      ]
     },
     "states": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
       {
        "allOf": [
         {
          "type": "object",
          "required": [
           "color",
           "label",
           "meanSdFromAverage",
           "sdWithinState",
           "expectedDurationDays",
           "shareOfDays"
          ],
          "properties": {
           "color": {
            "enum": [
             "green",
             "grey",
             "red"
            ]
           },
           "label": {
            "enum": [
             "good",
             "mid",
             "too much"
            ]
           },
           "meanSdFromAverage": {
            "enum": [
             -1.5,
             0,
             0.0,
             1.5
            ]
           },
           "sdWithinState": {
            "type": "number",
            "exclusiveMinimum": 0
           },
           "expectedDurationDays": {
            "type": "number",
            "minimum": 1
           },
           "shareOfDays": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
           }
          }
         },
         {
          "properties": {
           "color": {
            "const": "green"
           }
          }
         }
        ]
       },
       {
        "allOf": [
         {
          "type": "object",
          "required": [
           "color",
           "label",
           "meanSdFromAverage",
           "sdWithinState",
           "expectedDurationDays",
           "shareOfDays"
          ],
          "properties": {
           "color": {
            "enum": [
             "green",
             "grey",
             "red"
            ]
           },
           "label": {
            "enum": [
             "good",
             "mid",
             "too much"
            ]
           },
           "meanSdFromAverage": {
            "enum": [
             -1.5,
             0,
             0.0,
             1.5
            ]
           },
           "sdWithinState": {
            "type": "number",
            "exclusiveMinimum": 0
           },
           "expectedDurationDays": {
            "type": "number",
            "minimum": 1
           },
           "shareOfDays": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
           }
          }
         },
         {
          "properties": {
           "color": {
            "const": "grey"
           }
          }
         }
        ]
       },
       {
        "allOf": [
         {
          "type": "object",
          "required": [
           "color",
           "label",
           "meanSdFromAverage",
           "sdWithinState",
           "expectedDurationDays",
           "shareOfDays"
          ],
          "properties": {
           "color": {
            "enum": [
             "green",
             "grey",
             "red"
            ]
           },
           "label": {
            "enum": [
             "good",
             "mid",
             "too much"
            ]
           },
           "meanSdFromAverage": {
            "enum": [
             -1.5,
             0,
             0.0,
             1.5
            ]
           },
           "sdWithinState": {
            "type": "number",
            "exclusiveMinimum": 0
           },
           "expectedDurationDays": {
            "type": "number",
            "minimum": 1
           },
           "shareOfDays": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
           }
          }
         },
         {
          "properties": {
           "color": {
            "const": "red"
           }
          }
         }
        ]
       }
      ]
     },
     "transition": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
       "type": "array",
       "minItems": 3,
       "maxItems": 3,
       "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       }
      }
     },
     "current": {
      "type": "object",
      "required": [
       "date",
       "probs",
       "color",
       "pctVsAverage",
       "bandPct"
      ],
      "properties": {
       "date": {
        "type": "string",
        "format": "date"
       },
       "probs": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        }
       },
       "color": {
        "enum": [
         "green",
         "grey",
         "red"
        ]
       },
       "pctVsAverage": {
        "type": "number"
       },
       "bandPct": {
        "type": "number",
        "exclusiveMinimum": 0
       }
      }
     },
     "timeline": {
      "type": "array",
      "minItems": 30,
      "items": {
       "type": "object",
       "required": [
        "date",
        "color",
        "pRed",
        "probs",
        "pctVsAverage",
        "bandPct"
       ],
       "properties": {
        "date": {
         "type": "string",
         "format": "date"
        },
        "color": {
         "enum": [
          "green",
          "grey",
          "red"
         ]
        },
        "pRed": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        },
        "pctVsAverage": {
         "type": "number"
        },
        "bandPct": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "probs": {
         "type": "array",
         "minItems": 3,
         "maxItems": 3,
         "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
         }
        }
       }
      }
     },
     "monthly": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "ym",
        "green",
        "grey",
        "red"
       ],
       "properties": {
        "ym": {
         "type": "string",
         "pattern": "^(19|20)\\d\\d-(0[1-9]|1[0-2])$"
        }
       }
      }
     },
     "outlook": {
      "type": "array",
      "minItems": 3,
      "items": {
       "type": "object",
       "required": [
        "days",
        "probs",
        "method",
        "skillVsLongRunMix",
        "n"
       ],
       "properties": {
        "days": {
         "type": "integer",
         "minimum": 1
        },
        "probs": {
         "type": "array",
         "minItems": 3,
         "maxItems": 3,
         "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
         }
        },
        "method": {
         "enum": [
          "ar1-gap",
          "long-run-mix"
         ]
        },
        "skillVsLongRunMix": {
         "type": "number"
        },
        "n": {
         "type": "integer",
         "minimum": 0
        }
       }
      }
     },
     "agreementWithBandRule": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "forecast": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "date",
        "probs",
        "color",
        "method",
        "skillVsLongRunMix",
        "n"
       ],
       "properties": {
        "date": {
         "type": "string",
         "format": "date"
        },
        "probs": {
         "type": "array",
         "minItems": 3,
         "maxItems": 3,
         "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
         }
        },
        "color": {
         "enum": [
          "green",
          "grey",
          "red"
         ]
        },
        "method": {
         "enum": [
          "ar1-gap",
          "long-run-mix"
         ]
        },
        "skillVsLongRunMix": {
         "type": "number"
        },
        "n": {
         "type": "integer",
         "minimum": 0
        }
       }
      }
     }
    }
   }
  }
 }
}
