{
  "name": "fairwatt-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Massachusetts energy data dashboard (FairWatt) built on the committed Backend/data artifacts.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "d3-array": "3.2.4",
    "d3-geo": "3.1.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "6.0.1",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@types/d3-array": "3.2.2",
    "@types/d3-geo": "3.1.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.2.4"
  }
}
